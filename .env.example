# Copie para .env e preencha a chave localmente.
OPENAI_API_KEY=
# OPENAI_ORG_ID=
# OPENAI_PROJECT_ID=

SWARM_CONFIG=examples/e2e_multi.yaml
SWARM_OUTPUT=artifacts/resultado.json
SWARM_RUN_ID=swarm-local
SWARM_OBJECTIVE=
SWARM_ORCHESTRATOR_COUNT=2
SWARM_WORKER_COUNT=2
SWARM_PRIMARY_MODEL=gpt-5.6-luna
SWARM_COORDINATOR_MODELS=gpt-5.6-luna
SWARM_WORKER_MODELS=gpt-5.6-luna
SWARM_ALLOWED_MODELS=gpt-5.6-luna
SWARM_MAX_PARALLEL_WORKERS=2
SWARM_MAX_MODEL_CALLS=10
SWARM_WORKER_MAX_TURNS=3
SWARM_TIMEOUT_SECONDS=240
SWARM_WORKER_TIMEOUT_SECONDS=90
SWARM_MAX_RETRIES_PER_TASK=1
SWARM_ON_WORKER_FAILURE=fail
SWARM_PROGRESS_WIDTH=20
